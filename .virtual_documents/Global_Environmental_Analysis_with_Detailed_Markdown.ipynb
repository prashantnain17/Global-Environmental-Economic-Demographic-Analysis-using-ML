)

plt.title("Missing Values Distribution")
plt.show()





df = df.dropna(
    subset=["CO2_Emissions"]
)

df = df[
    df["CO2_Emissions"] >= 0
].copy()

print("Dataset after removing missing target values:")
print(df.shape)





numerical_cols = [
    "Freshwater",
    "Birth_Rate",
    "CO2_Emissions",
    "Death_Rate",
    "Energy_Use",
    "GDP",
    "Population"
]

outlier_summary = {}

for col in numerical_cols:

    Q1 = df[col].quantile(0.25)
    Q3 = df[col].quantile(0.75)

    IQR = Q3 - Q1

    lower = Q1 - 1.5 * IQR
    upper = Q3 + 1.5 * IQR

    outlier_summary[col] = (
        (df[col] < lower) |
        (df[col] > upper)
    ).sum()

display(
    pd.DataFrame(
        list(outlier_summary.items()),
        columns=["Feature", "Outlier Count"]
    )
)





trend = df.groupby("Year")["CO2_Emissions"].mean().reset_index()

