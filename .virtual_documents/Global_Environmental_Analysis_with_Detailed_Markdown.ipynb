indicators = [
    "ER.H2O.FWTL.K3",
    "SP.DYN.CBRT.IN",
    "EN.GHG.CO2.MT.CE.AR5",
    "SP.DYN.CDRT.IN",
    "EG.USE.PCAP.KG.OE",
    "NY.GDP.MKTP.CD",
    "SP.POP.TOTL"
]

print("Total Indicators Selected:", len(indicators))











def cleaning_data(df):

    df = df.copy()

    # Keep only selected indicators
    df = df[df["Series Code"].isin(indicators)]

    # Remove missing identifiers
    df = df.dropna(
        subset=["Country Name", "Country Code", "Series Code"]
    )

    return df


Part1 = cleaning_data(Part1)
Part2 = cleaning_data(Part2)

print("Part 1 after cleaning:", Part1.shape)
print("Part 2 after cleaning:", Part2.shape)





Part1 = Part1.drop_duplicates(
    subset=["Country Code", "Series Code"],
    keep="last"
)

Part2 = Part2.drop_duplicates(
    subset=["Country Code", "Series Code"],
    keep="last"
)

print("Part 1 duplicates:", Part1.duplicated(
    subset=["Country Code", "Series Code"]
).sum())

print("Part 2 duplicates:", Part2.duplicated(
    subset=["Country Code", "Series Code"]
).sum())











combined = pd.concat(
    [Part1, Part2],
    ignore_index=True
)

combined = combined.drop_duplicates(
    subset=["Country Code", "Series Code"],
    keep="last"
)

print("Combined Dataset Shape:", combined.shape)

display(combined.head())





print("Total Countries:", combined["Country Code"].nunique())

print("Total Indicators:", combined["Series Code"].nunique())

print("Total Duplicate Records:", combined.duplicated(
    subset=["Country Code", "Series Code"]
).sum())

print("\nIndicator Distribution:")

print(combined["Series Name"].value_counts())





print("Missing Values in Combined Dataset:")

print(combined.isnull().sum())





year_cols = [
    col for col in combined.columns
    if "[YR" in col
]

print("Year Columns:")
print(year_cols)





df_long = combined.melt(
    id_vars=[
        "Country Name",
        "Country Code",
        "Series Name",
        "Series Code"
    ],
    value_vars=year_cols,
    var_name="Year",
    value_name="Value"
)

df_long["Year"] = (
    df_long["Year"]
    .str.extract(r"(\d{4})")
    .astype(int)
)

df_long["Value"] = pd.to_numeric(
    df_long["Value"],
    errors="coerce"
)

print("Long Dataset Shape:", df_long.shape)

display(df_long.head(10))





df = df_long.pivot_table(
    index=[
        "Country Name",
        "Country Code",
        "Year"
    ],
    columns="Series Code",
    values="Value",
    aggfunc="first"
).reset_index()

print("Master Dataset Shape:", df.shape)

display(df.head())





df = df.rename(columns={
    "ER.H2O.FWTL.K3": "Freshwater",
    "SP.DYN.CBRT.IN": "Birth_Rate",
    "EN.GHG.CO2.MT.CE.AR5": "CO2_Emissions",
    "SP.DYN.CDRT.IN": "Death_Rate",
    "EG.USE.PCAP.KG.OE": "Energy_Use",
    "NY.GDP.MKTP.CD": "GDP",
    "SP.POP.TOTL": "Population"
})

print("Final Columns:")
print(df.columns.tolist())

display(df.head())





df.info()

print("\nStatistical Summary:")

display(df.describe())





